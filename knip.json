{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "**/__tests__/**/*.{ts,tsx}",
    "**/*.{test,spec}.{ts,tsx}"
  ],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "libs/**/*.{ts,tsx}"],
  "rules": {
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "ignore": [
    "libs/validations/generated/**",
    "src/features/logistica/components/PedidoDetalleModal.tsx",
    "src/features/socios/api/queries.ts"
  ],
  "ignoreDependencies": [
    "@react-native-community/datetimepicker",
    "@tanstack/query-async-storage-persister",
    "expo-asset",
    "expo-blur",
    "expo-font",
    "expo-system-ui",
    "openapi-typescript",
    "ts-jest"
  ]
}
